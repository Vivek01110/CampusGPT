PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/askcampusai
JWT_SECRET=super_secret_jwt_key_askcampusai_2026_dev_phrase
CLIENT_URL=http://localhost:5173

# Google Gemini Configuration (Embeddings & LLM)
GEMINI_API_KEY=your_gemini_api_key_here
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSION=768
LLM_MODEL=gemini-3.8-flash

# Qdrant Vector Database
QDRANT_CLUSTER_API_KEY=your_qdrant_api_key_here
QDRANT_CLUSTER_END_POINT=https://your-cluster-url.aws.cloud.qdrant.io
QDRANT_COLLECTION_NAME=askcampus_documents

# Phase 2 & 3: RAG Retrieval Tuning
RAG_VECTOR_TOP_K=20
RAG_KEYWORD_TOP_K=20
RAG_FINAL_TOP_K=5
RAG_RRF_K=60
RAG_MIN_SCORE=0.35

# Reranker Configuration (options: 'local', 'gemini')
RERANKER_PROVIDER=local

# Redis Cache (Optional, in-memory fallback enabled if offline)
REDIS_URL=redis://127.0.0.1:6379

# Ingestion & Crawler Limits
MAX_PDF_PAGES=200
MAX_DOCUMENT_SIZE_MB=25
